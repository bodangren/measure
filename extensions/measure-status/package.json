{
  "name": "measure-status",
  "version": "0.1.0",
  "private": true,
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "panel": {
        "id": "measure-status",
        "name": "Measure",
        "icon": "list-check",
        "entry": "panel/index.html",
        "mobile": true
      },
      "statusSection": {
        "entry": "panel/index.html",
        "title": "Measure",
        "height": 48
      },
      "page": true,
      "capabilities": ["files"],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "sessionControl": {},
      "filesystem": [
        "~/Desktop/reading-advantage-monorepo/measure/**",
        "~/Desktop/Workbooks/measure/**",
        "~/Desktop/advantage-pr/measure/**",
        "~/Desktop/advantage-forge/measure/**",
        "~/Desktop/mastery-advantage/measure/**",
        "~/Desktop/lending-desk-bench/measure/**",
        "~/Desktop/advantage-mmorpg/measure/**",
        "~/Desktop/measure/measure/**"
      ]
    }
  },
  "devDependencies": {
    "@openchamber/sdk": "2.8.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
